# ============================================================
# De-MOVEZZ LOGISTICS - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- AIRTABLE ----
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ---- FIREBASE (Client-side) ----
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:XXXXXXXXXXXXXXXXXXXXXXXX

# ---- FIREBASE ADMIN (Server-side) ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ---- APP ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---- RESEND (Transactional email) ----
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=De-MOVEZZ LOGISTICS <noreply@ship.gomovezz.com>

# ---- CLOUDINARY (Item photo uploads) ----
# Create a free account at https://cloudinary.com
# Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ---- WHATSAPP (via Airtable Automation - see docs) ----
# Airtable automations handle WhatsApp - configure in Airtable UI
# Optionally add WhatsApp Business API direct integration:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- POSTGRESQL (used ONLY when MOVEZZ_DATA_BACKEND=postgres; the default and today's production is Airtable - see docs/ROUTE-MIGRATION.md) ----
# Unset or `airtable` = Airtable. `postgres` = PostgreSQL for every route (Airtable is then hard-disabled). Any other value fails closed.
MOVEZZ_DATA_BACKEND=
# Optional: JSON log lines (no secrets, no personal data) to stderr
MOVEZZ_LOG=
# Runtime role (movezz_app: DML only). Different databases/credentials for development, staging and production.
DATABASE_URL=
DATABASE_SSL=true
# Migration role (movezz_migrator). Used only by `npm run db:migrate`; never by the running application.
MIGRATION_DATABASE_URL=
# Base64 signing key (>= 32 random bytes) for the per-transaction actor assertion; also provisioned in PostgreSQL with
# movezz_sec.set_actor_key(). Server-side only, one per environment, never reused across environments. See DATABASE-ARCHITECTURE.md 13b.
ACTOR_CONTEXT_KEY=
# Optional salt for the registration throttle's source hash (the IP itself is never stored). Per environment.
REGISTRATION_THROTTLE_PEPPER=

# ---- KEEPUP (invoice/payment synchronisation; the worker is disabled by default and mock-only until the controlled cutover test) ----
KEEPUP_API_KEY=

# ---- PostgreSQL-mode operations (see docs/CUTOVER-RUNBOOK.md) ----
# Keepup worker mode: disabled (default) | mock | sandbox | live. Only "live" (+ MOVEZZ_KEEPUP_ALLOW_PRODUCTION=true) counts as live for readiness.
MOVEZZ_KEEPUP_MODE=
MOVEZZ_KEEPUP_ALLOW_PRODUCTION=
KEEPUP_BASE_URL=
# Set to "false" only as an explicit owner waiver of Keepup synchronisation (readiness then does not require it).
MOVEZZ_KEEPUP_REQUIRED=
# Bearer token (>=16 chars) that unlocks the per-check detail of GET /api/ready. Anonymous callers only learn ready/not ready.
READINESS_TOKEN=
